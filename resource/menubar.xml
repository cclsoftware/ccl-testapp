<?xml version="1.0" encoding="UTF-8"?>
<MenuBar>
		
    <!-- ********************************************************************************** -->
    <!-- *** Application menu (Mac) ******************************************************* -->
    <!-- ********************************************************************************** -->

	<?platform mac?>
    <Menu name="Application">
        <MenuItem category="Help" name="About" title="About $APPNAME"/>
        <MenuSeparator/>
		<MenuItem category="File" name="Quit" title="Quit $APPNAME"/>
    </Menu>
	<?platform?>

    <!-- ********************************************************************************** -->
    <!-- *** File Menu ******************************************************************** -->
    <!-- ********************************************************************************** -->

	<Menu name="File">
		<MenuItem category="Unit Test" name="Run Selected"/>
		<MenuItem category="Unit Test" name="Run All"/>
		<MenuItem category="Unit Test" name="Cancel"/>
		
        <MenuSeparator/>
		
		<?platform win linux?>
		<MenuItem name="Quit"/>
		<?platform?>
	</Menu>
	
    <!-- ********************************************************************************** -->
    <!-- *** Help Menu ******************************************************************** -->
    <!-- ********************************************************************************** -->

    <Menu name="Help">
        <MenuItem name="Website" title="$APPNAME Website"/>
      
		<?platform win linux?>
        <MenuSeparator/>
        <MenuItem name="About" title="About $APPNAME" follow="1"/>
		<?platform?>
    </Menu>
	
</MenuBar>
